# Read-only connection to the database that holds the `candles` table.
# Used only for the list of symbols (GET /models, model polling) and for
# scripts/predict_cli.py; /predict takes its candles from the request body.
DATABASE_URL=postgresql+psycopg2://readonly_user:CHANGE_ME@<db-host>:5432/pinance

# Model artifacts live in MinIO, not on local disk. Fixed keys per symbol:
#   {symbol}/production/metadata.json, h1.txt..h12.txt (median / q50, also the
#   point prediction), h1_q0.1.txt..h12_q0.1.txt, h1_q0.9.txt..h12_q0.9.txt
# and the same under {symbol}/candidate/ (served at POST /predict/{symbol}/shadow;
# normally empty, in which case that endpoint returns 404). Slots are polled every
# MODEL_POLL_INTERVAL_SECONDS; a version change is hot-swapped in, no restart.
#
# All four are required: there is no local-disk fallback (see model_registry.py).
# Never commit real values here; put them in an untracked .env.
MINIO_ENDPOINT=<minio-host>:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_SECURE=false
MINIO_MODELS_BUCKET=pinance-models

# How often to poll MinIO for a new model version (seconds).
MODEL_POLL_INTERVAL_SECONDS=600
